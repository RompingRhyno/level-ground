// Prisma schema for Vercel Postgres
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Page {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  label     String
  sections  Json
  order     Int      @default(0)
  type      String   @default("page")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Asset {
  id         String   @id @default(uuid())
  storageKey String
  provider   String
  folder     String?
  orderIndex Int?
  tags       String[]
  size       Int?
  publicUrl  String?
  filename   String?
  mime       String?
  width      Int?
  height     Int?
  alt        String?
  meta       Json?
  migrated   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([folder, orderIndex])
  @@index([provider])
}

model Folder {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?
  parentId    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([slug])
}

model MediaUsage {
  id        Int      @id @default(autoincrement())
  assetId   String
  pageSlug  String
  createdAt DateTime @default(now())

  @@unique([assetId, pageSlug])
  @@index([assetId])
  @@index([pageSlug])
}

model ContactRecipient {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
}
