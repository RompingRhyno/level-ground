// Prisma schema for Vercel Postgres
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ─── Auth enums ───────────────────────────────────────────────────────────────

enum UserRole {
  owner
  admin
}

enum TokenType {
  unlock
  reset
  invite
  email_change
}

// ─── Auth tables (app-owned) ──────────────────────────────────────────────────
// `users` and `session` are written and read by the app's own sign-in/validation code
// (src/app/api/auth/sign-in, src/lib/session.ts). The `account` / `verification` tables that came
// with Better Auth were dropped in 2026-09 along with the dependency — nothing ever read them.

model User {
  id             String       @id @default(cuid())
  name           String
  email          String       @unique
  emailVerified  Boolean      @default(false)
  image          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  // Custom auth fields
  passwordHash   String?
  role           UserRole     @default(admin)
  failedAttempts Int          @default(0)
  lockedAt       DateTime?
  pendingEmail   String?
  lastLoginAt    DateTime?
  sessions       Session[]
  unlockTokens   UnlockToken[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

// ─── Custom auth table ────────────────────────────────────────────────────────

model UnlockToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  type      TokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("unlock_tokens")
}

model Page {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  label     String
  sections  Json
  order     Int      @default(0)
  type      String   @default("page")
  /// Render this page's entry in the sticky header nav as a pill button (the `.btn-primary` style) instead
  /// of the underlined link, for extra emphasis. Per page: the nav shows every page, so the emphasis is
  /// chosen one entry at a time.
  navPill   Boolean  @default(false)
  /// Render a floating "jump to top" circle button (bottom-right) on this page's public view once
  /// the visitor has scrolled past the first viewport.
  jumpToTop Boolean  @default(false)
  /// SEO title, used verbatim (bypassing the site's "| Level Ground Landscape" suffix). Falls back to
  /// `<label> | Level Ground Landscape` when unset. Seeded from the legacy site's titles.
  metaTitle       String?
  /// SEO description. Falls back to the page's hero subheading when unset.
  metaDescription String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// The service vocabulary — categories that cover tags sit under. Seeded from the static list in
/// src/lib/services.ts (that file remains the runtime fallback for client components and the
/// redirect map); this table is the live source, so the admin can create services from the tag
/// modal. Always one of the two groups, matching the two service pages.
model Service {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  name      String
  group     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Asset {
  id         String   @id @default(uuid())
  storageKey String
  provider   String
  folder     String?
  orderIndex Int?
  size       Int?
  publicUrl  String?
  filename   String?
  mime       String?
  width      Int?
  height     Int?
  alt        String?
  meta       Json?
  migrated   Boolean  @default(false)
  /// Hidden from dynamic galleries (folder/tag filtered, collection index, /projects detail) and ordered
  /// last so it can never become a folder cover. Still renders in static galleries and in the pickers.
  hidden     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([folder, orderIndex])
  @@index([provider])
}

model Folder {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?
  parentId    Int?
  tags        String[] @default([])
  /// Manual display order for the admin grid and /projects (lower first).
  order       Int      @default(0)
  /// When true the folder is excluded from /projects (index and detail route).
  hidden      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([order, hidden])
}

model Tag {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?
  /// The service this tag sits under (a service slug). Tags are the specific covers a project
  /// earned; services are the categories above them. This field is the wiring: a service page or
  /// the gallery picker gathers its covers by looking up tags whose `service` matches.
  /// Vocabulary: docs/services-revamp-plan.md and docs/services-revamp-tags.csv.
  service     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([service])
}

model MediaUsage {
  id        Int      @id @default(autoincrement())
  assetId   String
  pageSlug  String
  createdAt DateTime @default(now())

  @@unique([assetId, pageSlug])
  @@index([assetId])
  @@index([pageSlug])
}

model ContactRecipient {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
}

model ContactUploadSession {
  id        String          @id
  sectionId String
  createdAt DateTime        @default(now())
  expiresAt DateTime
  uploads   ContactUpload[]
}

model ContactUpload {
  id              Int                  @id @default(autoincrement())
  session         ContactUploadSession @relation(fields: [sessionId], references: [id])
  sessionId       String
  key             String               @unique
  createdAt       DateTime             @default(now())
  status          String               @default("pending")
  cleanupAttempts Int                  @default(0)

  @@index([sessionId])
}
